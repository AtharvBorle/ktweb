{
  "name": "kunaltilak-official-website",
  "version": "2.0.0",
  "description": "Official Website & CMS for Kunal Tilak (Clean Decoupled Architecture)",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:db:push": "npm --prefix backend run prisma:db:push",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "deploy:dev": "bash deploy-dev.sh",
    "deploy:prod": "bash deploy-prod.sh"
  },
  "keywords": [
    "kunal-tilak",
    "cms",
    "express",
    "prisma",
    "clean-architecture",
    "decoupled"
  ],
  "author": "Kunal Tilak Tech Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
